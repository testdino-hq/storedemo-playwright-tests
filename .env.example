# ---- Target environment ----
BASE_URL=https://storedemo.testdino.com
API_BASE_URL=https://storedemo-api.testdino.com/api

# ---- Shared demo account (read-only tests). Mutating tests create their own per-worker users. ----
DEMO_USER_EMAIL=dino.qa.demo@testdino.com
DEMO_USER_PASSWORD=Dino@12345

# ---- Result-mix controls (for demo data generation) ----
# CHAOS=on|off   -> enable the chaos helper that makes @flaky tests fail intermittently on the first attempt
# FLAKY_RATE     -> probability (0..1) that a @flaky test fails its first attempt (default 0.4)
CHAOS=on
FLAKY_RATE=0.4

# ---- Cross-browser (firefox/webkit run only when set) ----
CROSS_BROWSER=

# ---- TestDino reporter ----
TESTDINO_TOKEN=
TESTDINO_CI_RUN_ID=
